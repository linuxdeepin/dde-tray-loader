[Unit]
Description=DDE Tray Plugin Loader target
# Tray plugin processes render into the dock's internal dockplugin Wayland
# compositor exported by dde-shell. Their lifetime is therefore bound to the
# dock shell: BindsTo stops them when the shell disappears, and PartOf also
# propagates explicit dock restarts. The dock acquires its Type=dbus name
# after its compositor is ready; After= waits for that startup/restart job.
# On shutdown the ordering reverses: the dock waits for the tray groups.
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
BindsTo=dde-shell@DDE.service
After=dde-shell@DDE.service
# Core shutdown already propagates through the dock; bind only to its lifetime.
PartOf=dde-shell@DDE.service
