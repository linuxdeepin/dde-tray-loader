<RCC>
    <qresource prefix="/dsg/built-in-icons">
        <file alias="dock-music-next.dci">texts/dock-music-next.dci</file>
        <file alias="dock-music-paused.dci">texts/dock-music-paused.dci</file>
        <file alias="dock-music-previous.dci">texts/dock-music-previous.dci</file>
        <file alias="dock-music-start.dci">texts/dock-music-start.dci</file>
    </qresource>
    <qresource prefix="/icons/deepin/builtin">
        <file>texts/play-next_24px.svg</file>
        <file>texts/play-previous_24px.svg</file>
        <file>texts/open-arrow_16px.svg</file>
        <file>texts/play-pause_24px.svg</file>
        <file>texts/play-start_24px.svg</file>
    </qresource>
    <qresource prefix="/">
        <file>deepin-music.svg</file>
    </qresource>
    <qresource prefix="/media">
        <file alias="card">qml/MusicCard.qml</file>
    </qresource>
</RCC>
